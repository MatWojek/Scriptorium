<h1 class="font-display text-2xl text-paper mb-8">Dashboard</h1>

<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
  <div class="bg-[#2f2f2f] rounded-xl p-6 border border-white/5">
    <p class="text-xs uppercase tracking-wider text-paper/40 mb-2">Articles</p>
    <p class="font-display text-3xl text-paper"><%= @articles_count %></p>
  </div>
  <div class="bg-[#2f2f2f] rounded-xl p-6 border border-white/5">
    <p class="text-xs uppercase tracking-wider text-paper/40 mb-2">Comments</p>
    <p class="font-display text-3xl text-paper"><%= @comments_count %></p>
  </div>
  <div class="bg-[#2f2f2f] rounded-xl p-6 border border-white/5">
    <p class="text-xs uppercase tracking-wider text-paper/40 mb-2">Users</p>
    <p class="font-display text-3xl text-paper"><%= @users_count %></p>
  </div>
</div>

<div class="flex gap-3">
  <%= link_to "Manage articles", admin_articles_path,
        class: "px-5 py-2.5 rounded-lg text-sm font-medium bg-white/5 text-paper hover:bg-white/10 transition" %>
  <%= link_to "Manage comments", admin_comments_path,
        class: "px-5 py-2.5 rounded-lg text-sm font-medium bg-white/5 text-paper hover:bg-white/10 transition" %>
  <%= link_to "Manage users", admin_users_path,
        class: "px-5 py-2.5 rounded-lg text-sm font-medium bg-white/5 text-paper hover:bg-white/10 transition" %>
</div>