<%# Partial: users/_user.html.erb
    Compact user info card — used in admin views and other listing contexts.
    Expects: `user` (User object)
    Note: @user is used for action paths in own-account context (admin edit).
%>

<div id="<%= dom_id user %>" class="bg-[#252525] rounded-xl border border-white/8 overflow-hidden">

  <%# Header strip %>
  <div class="flex items-center gap-3 px-5 py-4 border-b border-white/5">
    <% if user.avatar.attached? %>
      <%= image_tag user.avatar.variant(resize_to_fill: [56, 56]),
            class: "w-10 h-10 rounded-full object-cover ring-1 ring-white/10 shrink-0" %>
    <% else %>
      <div class="w-10 h-10 rounded-full bg-carmine/80 flex items-center justify-center text-sm font-bold text-paper shrink-0">
        <%= user.username.first.upcase %>
      </div>
    <% end %>
    <div class="min-w-0">
      <p class="text-sm font-semibold text-paper truncate"><%= user.username %></p>
      <p class="text-xs text-paper/40 truncate"><%= user.email %></p>
    </div>
    <% if user.role %>
      <span class="ml-auto shrink-0 text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-carmine/10 text-carmine border border-carmine/20">
        <%= user.role %>
      </span>
    <% end %>
  </div>

  <%# Info rows %>
  <dl class="divide-y divide-white/5 px-5">
    <div class="flex items-start gap-4 py-3">
      <dt class="w-24 shrink-0 text-[10px] font-semibold uppercase tracking-widest text-paper/35 pt-0.5">
        <%= t("user.info.first_name") %>
      </dt>
      <dd class="text-sm text-paper/80"><%= user.first_name.presence || "—" %></dd>
    </div>
    <div class="flex items-start gap-4 py-3">
      <dt class="w-24 shrink-0 text-[10px] font-semibold uppercase tracking-widest text-paper/35 pt-0.5">
        <%= t("user.info.last_name") %>
      </dt>
      <dd class="text-sm text-paper/80"><%= user.last_name.presence || "—" %></dd>
    </div>
    <div class="flex items-start gap-4 py-3">
      <dt class="w-24 shrink-0 text-[10px] font-semibold uppercase tracking-widest text-paper/35 pt-0.5">
        <%= t("user.info.bio") %>
      </dt>
      <dd class="text-sm text-paper/80 leading-relaxed"><%= user.bio.presence || "—" %></dd>
    </div>
  </dl>

  <%# Actions — only rendered for the admin/own context where @user is set %>
  <% if defined?(@user) && @user == user %>
    <div class="flex flex-wrap gap-2 px-5 py-4 border-t border-white/5 bg-black/10">
      <%= link_to t("account.user.edit_user_info"), edit_user_path(@user),
            class: "px-4 py-2 rounded-lg text-sm font-medium bg-white/5 text-paper hover:bg-white/10 transition" %>
      <% if user.admin? %>
        <%= link_to t("account.admin.back_to_users"), admin_users_path,
              class: "px-4 py-2 rounded-lg text-sm font-medium text-paper/40 hover:text-paper hover:bg-white/5 transition" %>
      <% end %>
      <%= button_to t("account.user.delete_user"), @user, method: :delete,
            form_class: "inline-block",
            class: "bg-carmine/10 text-carmine border border-carmine/25 px-4 py-2 rounded-lg text-sm font-medium hover:bg-carmine hover:text-paper hover:border-carmine transition",
            data: { turbo_confirm: t("base.confirm") } %>
    </div>
  <% end %>

</div>