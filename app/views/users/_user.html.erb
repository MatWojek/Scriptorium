<div id="<%= dom_id user %>" class="w-full sm:w-auto my-5">
  <dl class="divide-y divide-white/5">
    <div class="flex items-start gap-4 py-3">
      <dt class="w-28 shrink-0 text-xs font-semibold uppercase tracking-widest text-carmine/80 pt-0.5"><%= t("user.info.username") %></dt>
      <dd class="text-sm text-paper/85"><%= user.username %></dd>
    </div>
    <div class="flex items-start gap-4 py-3">
      <dt class="w-28 shrink-0 text-xs font-semibold uppercase tracking-widest text-carmine/80 pt-0.5"><%= t("user.info.email") %></dt>
      <dd class="text-sm text-paper/85"><%= user.email %></dd>
    </div>
    <div class="flex items-start gap-4 py-3">
      <dt class="w-28 shrink-0 text-xs font-semibold uppercase tracking-widest text-carmine/80 pt-0.5"><%= t("user.info.first_name") %></dt>
      <dd class="text-sm text-paper/85"><%= user.first_name %></dd>
    </div>
    <div class="flex items-start gap-4 py-3">
      <dt class="w-28 shrink-0 text-xs font-semibold uppercase tracking-widest text-carmine/80 pt-0.5"><%= t("user.info.last_name") %></dt>
      <dd class="text-sm text-paper/85"><%= user.last_name %></dd>
    </div>
    <div class="flex items-start gap-4 py-3">
      <dt class="w-28 shrink-0 text-xs font-semibold uppercase tracking-widest text-carmine/80 pt-0.5"><%= t("user.info.bio") %></dt>
      <dd class="text-sm text-paper/85 leading-relaxed"><%= user.bio.presence || "-" %></dd>
    </div>
    <div class="flex items-start gap-4 py-3">
      <dt class="w-28 shrink-0 text-xs font-semibold uppercase tracking-widest text-carmine/80 pt-0.5"><%= t("user.info.role") %></dt>
      <dd>
        <span class="inline-block text-xs font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-carmine/10 text-carmine border border-carmine/20">
          <%= user.role.name %>
        </span>
      </dd>
    </div>
    <div class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-white/5">
    <%= link_to t("account.user.edit_user_info"), edit_user_path(@user),
          class: "px-5 py-2.5 rounded-lg text-sm font-medium bg-white/5 text-paper hover:bg-white/10 transition" %>
    <% if @user.admin? %>
      <%= link_to t("account.admin.back_to_users"), admin_users_path,
            class: "px-5 py-2.5 rounded-lg text-sm font-medium text-paper/50 hover:text-paper hover:bg-white/5 transition" %>
    <% end %>
    <%= button_to t("account.user.delete_user"), @user, method: :delete,
          form_class: "inline-block",
          class: "bg-carmine/15 text-carmine border border-carmine/30 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-carmine hover:text-paper hover:border-carmine transition",
          data: { turbo_confirm: t("base.confirm") } %>
  </div>
  </dl>
</div>