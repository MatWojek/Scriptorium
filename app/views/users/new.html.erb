<div class="min-h-screen grid md:grid-cols-2">
  <%# Form %>
  <div class="flex items-center justify-center bg-ink px-6 py-16">
    <div class="w-full max-w-sm">
      <%= link_to "Scriptorium", root_path, class: "font-display text-xl text-paper/60 block mb-10" %>
      <h1 class="font-display text-3xl text-paper mb-8"><%= t("account.create.create_account") %></h1>

      <%= form_with model: @user, class: "space-y-5" do |f| %>
        <% if @user.errors.any? %>
          <div class="bg-carmine/10 border border-carmine/30 text-carmine text-sm rounded-lg px-4 py-3">
            <%= pluralize(@user.errors.count, "error") %> prevented this account from being created.
          </div>
        <% end %>

        <div>
          <%= f.label :username, t("account.info.username"), class: "block text-sm text-paper/70 mb-2" %>
          <%= f.text_field :username, class: "w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-paper focus:outline-none focus:border-carmine transition" %>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <%= f.label :first_name, t("account.info.first_name"), class: "block text-sm text-paper/70 mb-2" %>
            <%= f.text_field :first_name, class: "w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-paper focus:outline-none focus:border-carmine transition" %>
          </div>
          <div>
            <%= f.label :last_name, t("account.info.last_name"), class: "block text-sm text-paper/70 mb-2" %>
            <%= f.text_field :last_name, class: "w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-paper focus:outline-none focus:border-carmine transition" %>
          </div>
        </div>

        <div>
          <%= f.label :email, t("account.info.email"), class: "block text-sm text-paper/70 mb-2" %>
          <%= f.email_field :email, class: "w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-paper focus:outline-none focus:border-carmine transition" %>
        </div>

        <div data-controller="password-check">
          <div>
            <%= f.label :password, class: "block text-sm text-paper/70 mb-2" %>
            <%= f.password_field :password,
                  data: { password_check_target: "password", action: "input->password-check#check" },
                  class: "w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-paper focus:outline-none focus:border-carmine transition" %>

            <ul class="mt-2 space-y-1 text-xs">
              <li data-password-check-target="length" class="text-paper/30">At least 8 characters</li>
              <li data-password-check-target="lowercase" class="text-paper/30">One lowercase letter</li>
              <li data-password-check-target="uppercase" class="text-paper/30">One uppercase letter</li>
              <li data-password-check-target="digit" class="text-paper/30">One number</li>
            </ul>
          </div>

          <div class="mt-4">
            <%= f.label :password_confirmation, class: "block text-sm text-paper/70 mb-2" %>
            <%= f.password_field :password_confirmation,
                  data: { password_check_target: "confirmation", action: "input->password-check#checkMatch" },
                  class: "w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-paper focus:outline-none focus:border-carmine transition" %>
          </div>
        </div>

        <div>
          <%= f.label :language_id, t("account.create.preferred_language"), class: "block text-sm text-paper/70 mb-2" %>
          <%= f.collection_select :language_id, Language.all, :id, :name,
                { prompt: t("articles.create.select_language") },
                class: "w-full bg-[#2f2f2f] border border-white/10 rounded-lg px-4 py-3 text-paper focus:outline-none focus:border-carmine transition" %>
        </div>

        <%= f.submit t("account.create.create_account"), class: "w-full bg-carmine text-paper py-3 rounded-lg font-medium hover:bg-carmine/90 transition cursor-pointer" %>
      <% end %>

      <div>
        <p class="flex font-display text-sm text-paper/70 mb-2 px-6 py-3"><%= t("base.description.have_account") %>
          <%= link_to t("navbar.log_in"), new_session_path,
                class: "text-carmine px-2 font-medium mb-10" %>
        </p>
      </div>
    </div>
  </div>

  <%# Information Panel %>
  <div class="relative hidden md:flex items-center justify-center bg-violet px-12 py-16 overflow-hidden">
    <div class="absolute -right-24 -top-24 w-96 h-96 rounded-full bg-carmine/30 blur-3xl"></div>
    <div class="absolute -left-16 bottom-0 w-72 h-72 rounded-full bg-ink/50 blur-3xl"></div>

    <div class="relative max-w-sm">
      <h2 class="font-display text-2xl text-paper mb-6"><%= t("base.description.have_account") %></h2>
      <%= link_to t("navbar.log_in"), new_session_path,
            class: "inline-block bg-paper text-violet px-6 py-3 rounded-lg font-medium mb-10 hover:bg-paper/90 transition" %>

      <h3 class="font-display text-lg text-paper mb-4"><%= t("base.description.why_join") %></h3>
      <ul class="space-y-3 text-paper/80 text-sm">
        <li class="flex gap-3"><span class="text-carmine">—</span> <%= t("base.description.publish") %></li>
        <li class="flex gap-3"><span class="text-carmine">—</span> <%= t("base.description.comment") %></li>
        <li class="flex gap-3"><span class="text-carmine">—</span> <%= t("base.description.like") %></li>
        <li class="flex gap-3"><span class="text-carmine">—</span> <%= t("base.description.build") %></li>
      </ul>
    </div>
  </div>
</div>