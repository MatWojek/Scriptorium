<div id="<%= dom_id like %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Value:</strong>
    <%= like.value %>
  </div>
  <div>
    <strong class="block font-medium mb-1">User:</strong>
    <%= like.user_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Article:</strong>
    <%= like.article_id %>
  </div>
</div>
