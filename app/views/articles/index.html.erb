<% content_for :title, t("articles.index.title") %>

<div class="w-full pb-24 md:pb-0">

  <%# ── Header ── %>
  <div class="w-full max-w-3xl mx-auto px-4 pt-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="font-display text-3xl text-paper"><%= t("articles.index.title") %></h1>
        <p class="text-sm text-paper/40 mt-1">
          <%= "#{@articles.size} #{t('articles.index.number_of_published_articles')}" %>
        </p>
      </div>
      <%# New article button — visible on mobile only (desktop uses navbar link) %>
      <% if logged_in? %>
        <%= link_to new_article_path,
              class: "md:hidden shrink-0 inline-flex items-center gap-1.5 bg-carmine text-paper px-4 py-2 rounded-lg text-sm font-semibold hover:bg-carmine/85 active:scale-95 transition" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <%= t("navbar.new_article") %>
        <% end %>
      <% end %>
    </div>

    <%# ── Search ── %>
    <div id="search" class="mb-4">
      <%= form_with url: articles_path, method: :get,
            data: { controller: "search", turbo_frame: "articles-list" } do %>
        <div class="relative">
          <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-paper/35 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 10a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <%= text_field_tag :q, params[:q],
                placeholder: t("articles.index.search_placeholder", default: "Search articles…"),
                data: { action: "input->search#submit" },
                class: "w-full bg-[#2a2a2a] border border-white/8 rounded-xl pl-10 pr-4 py-2.5 text-paper text-sm placeholder:text-paper/30 focus:outline-none focus:border-carmine/50 focus:ring-1 focus:ring-carmine/15 transition" %>
        </div>

        <%# Active tag pill (keep q in scope) %>
        <% if params[:tag].present? %>
          <div class="flex items-center gap-2 mt-2">
            <span class="text-xs text-paper/40">Tag:</span>
            <span class="flex items-center gap-1 bg-carmine/10 text-carmine px-2.5 py-1 rounded-full text-xs font-medium border border-carmine/20">
              #<%= params[:tag] %>
              <%= link_to "×", articles_path(request.query_parameters.except("tag")),
                    class: "ml-0.5 hover:text-paper transition" %>
            </span>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# ── Filters panel (collapsible) ── %>
    <details class="mb-8 group" <%= "open" if params[:category_id].present? || params[:language_id].present? || params[:sort].present? %>>
      <summary class="list-none [&::-webkit-details-marker]:hidden cursor-pointer inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-white/5 hover:bg-white/8 text-sm text-paper/70 hover:text-paper transition select-none">
        <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z" />
        </svg>
        <span>Sort &amp; Filter</span>
        <% active_count = [params[:category_id], params[:language_id], params[:sort]].count(&:present?) %>
        <% if active_count > 0 %>
          <span class="ml-0.5 w-4 h-4 rounded-full bg-carmine text-paper text-[10px] font-bold flex items-center justify-center">
            <%= active_count %>
          </span>
        <% end %>
        <svg class="w-3.5 h-3.5 text-paper/30 ml-auto transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>

      <div class="mt-3 p-4 bg-[#252525] border border-white/8 rounded-xl">
        <%= form_with url: articles_path, method: :get, class: "grid grid-cols-1 sm:grid-cols-3 gap-3" do %>
          <%# Preserve search query and tag %>
          <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
          <%= hidden_field_tag :tag, params[:tag] if params[:tag].present? %>

          <div>
            <label class="block text-[10px] font-semibold uppercase tracking-widest text-paper/35 mb-1.5">Category</label>
            <%= select_tag :category_id,
                  options_for_select(
                    [["All categories", ""]] + Category.all.map { |c| [c.name, c.id] },
                    params[:category_id]
                  ),
                  class: "w-full bg-black/30 border border-white/10 rounded-lg px-3 py-2 text-paper text-sm focus:outline-none focus:border-carmine/50 transition appearance-none cursor-pointer",
                  onchange: "this.form.requestSubmit()" %>
          </div>

          <div>
            <label class="block text-[10px] font-semibold uppercase tracking-widest text-paper/35 mb-1.5">Language</label>
            <%= select_tag :language_id,
                  options_for_select(
                    [["All languages", ""]] + Language.all.map { |l| [l.name, l.id] },
                    params[:language_id]
                  ),
                  class: "w-full bg-black/30 border border-white/10 rounded-lg px-3 py-2 text-paper text-sm focus:outline-none focus:border-carmine/50 transition appearance-none cursor-pointer",
                  onchange: "this.form.requestSubmit()" %>
          </div>

          <div>
            <label class="block text-[10px] font-semibold uppercase tracking-widest text-paper/35 mb-1.5">Sort by</label>
            <%= select_tag :sort,
                  options_for_select(
                    [["Newest first", ""], ["Most liked", "most_liked"]],
                    params[:sort]
                  ),
                  class: "w-full bg-black/30 border border-white/10 rounded-lg px-3 py-2 text-paper text-sm focus:outline-none focus:border-carmine/50 transition appearance-none cursor-pointer",
                  onchange: "this.form.requestSubmit()" %>
          </div>

          <% if params[:category_id].present? || params[:language_id].present? || params[:sort].present? %>
            <div class="sm:col-span-3 flex justify-end pt-1 border-t border-white/5 mt-1">
              <%= link_to "Clear filters", articles_path(q: params[:q], tag: params[:tag]),
                    class: "text-xs text-paper/40 hover:text-carmine transition" %>
            </div>
          <% end %>
        <% end %>
      </div>
    </details>
  </div>

  <%# ── Article list ── %>
  <%= turbo_frame_tag "articles-list" do %>
    <% if @articles.empty? %>
      <div class="flex flex-col items-center justify-center py-24 text-center px-4">
        <div class="w-16 h-16 rounded-full bg-white/5 flex items-center justify-center mb-5">
          <svg class="w-8 h-8 text-paper/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <p class="font-display text-xl text-paper/30 mb-2"><%= t("articles.index.no_articles") %></p>
        <p class="text-sm text-paper/25 mb-6"><%= t("articles.index.first_write") %></p>
        <% if logged_in? %>
          <%= link_to t("articles.index.write_button"), new_article_path,
                class: "inline-flex items-center gap-2 bg-carmine/10 text-carmine border border-carmine/25 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-carmine hover:text-paper hover:border-carmine transition" %>
        <% end %>
      </div>
    <% else %>
      <div class="space-y-4 pb-4">
        <% @articles.each do |article| %>
          <div class="w-full max-w-3xl mx-auto px-4">
            <%= render article %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

</div>