<% content_for :title, t("articles.index.title") %>

<div class="w-full">

  <%# Header %>
  <div class="w-4/5 mx-auto">
    <div class="flex items-center justify-between mb-8 pb-6 border-b border-white/5">
      <div>
        <h1 class="font-display text-3xl text-paper"><%= t("articles.index.title") %></h1>
        <p class="text-sm text-paper/40 mt-1"><%= "#{@articles.size} #{t('articles.index.number_of_published_articles')}" %></p>
      </div>
      <%= link_to t("navbar.new_article"), new_article_path,
            class: "shrink-0 bg-carmine text-paper px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-carmine/85 active:scale-95 transition" %>
    </div>
  </div>

  <%# List %>
  <% if @articles.empty? %>
    <div class="flex flex-col items-center justify-center py-20 text-center">
      <p class="font-display text-2xl text-paper/30 mb-3"><%= t("articles.index.no_articles") %></p>
      <p class="text-sm text-paper/25 mb-6"><%= t("articles.index.first_write") %></p>
      <%= link_to t("articles.index.write_button"), new_article_path,
            class: "bg-carmine/10 text-carmine border border-carmine/25 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-carmine hover:text-paper hover:border-carmine transition" %>
    </div>
  <% else %>
    <div class="space-y-4">
      <% @articles.each do |article| %>
        <div class="w-4/5 mx-auto">
          <%= render article %>
        </div>
      <% end %>
    </div>
  <% end %>

</div>