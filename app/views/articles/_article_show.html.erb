<div class="block bg-[#2f2f2f] rounded-xl p-8 border border-white/5">

  <% if article.respond_to?(:category) && article.category %>
    <span class="inline-block text-xs font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-carmine/10 text-carmine border border-carmine/20 mb-4">
      <%= article.category.name %>
    </span>
  <% end %>

  <% if article.language %>
    <span class="text-xs text-paper/40 ml-2"><%= article.language.name %></span>
  <% end %>

  <h1 class="font-display text-4xl text-paper leading-tight mb-4">
    <%= article.title %>
  </h1>

  <div class="flex items-center gap-3 pb-6 border-b border-white/5">
    <span class="text-xs font-semibold uppercase tracking-widest text-carmine/70">
      <%= article.user.username %>
    </span>
    <span class="text-white/15">·</span>
    <span class="text-xs text-paper/40">
      <%= article.created_at.strftime("%B %-d, %Y") %>
    </span>
    <%= link_to t("articles.show.export_pdf"), export_pdf_article_path(article),
        class: "ml-auto text-xs font-medium px-3 py-1.5 rounded-lg bg-white/5 text-paper/70 hover:bg-white/10 hover:text-paper transition",
        target: "_blank", rel: "noopener" %>
  </div>

  <% if article.gallery_images.attached? %>
  <div class="border-t border-white/5 pt-6">


    <button
      type="button"
      onclick="
        const body = document.getElementById('gallery-body-<%= article.id %>');
        const icon = document.getElementById('gallery-icon-<%= article.id %>');
        const hidden = body.classList.toggle('hidden');
        icon.style.transform = hidden ? 'rotate(0deg)' : 'rotate(180deg)';
      "
      class="flex items-center gap-2 mb-5 text-sm font-semibold text-paper/60 hover:text-paper transition group"
    >
      <svg
        id="gallery-icon-<%= article.id %>"
        xmlns="http://www.w3.org/2000/svg"
        class="w-4 h-4 transition-transform duration-200"
        style="transform: rotate(180deg)"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>

      Gallery

      <span class="ml-1 text-xs font-normal px-2 py-0.5 rounded-full bg-white/5 text-paper/40">
        <%= article.gallery_images.count %>
      </span>
    </button>

    <div id="gallery-body-<%= article.id %>">

      <div class="grid grid-cols-3 gap-2 mb-8" data-controller="gallery">
        <% article.gallery_images.each_with_index do |img, i| %>

          <button
            type="button"
            data-action="gallery#open"
            data-index="<%= i %>"
            data-gallery-url="<%= url_for(img) %>"
            class="block aspect-square overflow-hidden rounded-lg border border-white/5">

            <%= image_tag img.variant(resize_to_fill: [300,300]),
                  class: "w-full h-full object-cover hover:opacity-80 transition" %>

          </button>

        <% end %>

        <div
          data-gallery-target="modal"
          data-close="true"
          data-action="click->gallery#close"
          class="hidden fixed inset-0 z-50 bg-black/90 flex items-center justify-center p-6">

          <button
            type="button"
            data-close="true"
            data-action="gallery#close"
            class="absolute top-6 right-6 text-paper text-2xl">
            ×
          </button>

          <button
            type="button"
            data-action="gallery#prev"
            class="absolute left-6 text-paper text-3xl">
            ‹
          </button>

          <img
            data-gallery-target="image"
            src=""
            class="max-h-[85vh] max-w-[85vw] object-contain rounded-lg">

          <button
            type="button"
            data-action="gallery#next"
            class="absolute right-6 text-paper text-3xl">
            ›
          </button>

        </div>
      </div>

    </div>
  </div>
  <% end %>

  <%# Article Content %>
  <div class="border-t border-white/5 pt-6">
    <div class="prose prose-invert max-w-none
        prose-p:text-paper/80 prose-p:leading-relaxed
        prose-headings:text-paper prose-headings:font-display
        prose-a:text-carmine prose-a:no-underline hover:prose-a:underline
        prose-strong:text-paper
        prose-blockquote:border-carmine/40 prose-blockquote:text-paper/60
        prose-code:text-carmine/90 prose-code:bg-black/30 prose-code:rounded prose-code:px-1
        [&_*]:text-paper/80 mb-8">
      <%= article.content %>
      <% if article.tags.any? %>
        <div class="flex flex-wrap gap-2 mt-4">
          <% article.tags.each do |tag| %>
            <span class="text-xs px-2.5 py-1 rounded-full bg-violet/30 text-paper/70">#<%= tag.name %></span>
          <% end %>
        </div>
      <% end %>
    </div>

    <% user_like = logged_in? ? article.likes.find_by(user: current_user) : nil %>

    <div class="flex items-center gap-2 mb-6">
      <%= button_to article_likes_path(article), params: { value: 1 }, method: :post,
            class: "flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm transition #{user_like&.value == 1 ? 'bg-carmine text-paper' : 'bg-white/5 text-paper/60 hover:bg-white/10'}" do %>
        ▲
      <% end %>

      <span class="text-sm text-paper/70 font-medium"><%= article.score %></span>

      <%= button_to article_likes_path(article), params: { value: -1 }, method: :post,
            class: "flex items-center gap-1 px-3 py-1.5 rounded-lg text-sm transition #{user_like&.value == -1 ? 'bg-carmine text-paper' : 'bg-white/5 text-paper/60 hover:bg-white/10'}" do %>
        ▼
      <% end %>
    </div>
  </div>

  <%# Comments section %>
  <div class="border-t border-white/5 pt-6" id="comments-section-<%= article.id %>">

    <button
      type="button"
      onclick="
        const body = document.getElementById('comments-body-<%= article.id %>');
        const icon = document.getElementById('comments-icon-<%= article.id %>');
        const hidden = body.classList.toggle('hidden');
        icon.style.transform = hidden ? 'rotate(0deg)' : 'rotate(180deg)';
      "
      class="flex items-center gap-2 mb-5 text-sm font-semibold text-paper/60 hover:text-paper transition group"
    >
      <svg id="comments-icon-<%= article.id %>" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200" style="transform: rotate(180deg)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
      <%= t("articles.show.comments") %>
      <span class="ml-1 text-xs font-normal px-2 py-0.5 rounded-full bg-white/5 text-paper/40">
        <%= article.comments.size %>
      </span>
    </button>

    <div id="comments-body-<%= article.id %>">

      <%= form_with model: [article, Comment.new], class: "mb-5" do |f| %>
        <div class="mb-3">
          <%= f.text_area :content,
                placeholder: "Write a comment...",
                rows: 3,
                class: "w-full bg-black/30 border border-white/10 rounded-lg px-4 py-3 text-sm text-paper placeholder:text-paper/30 focus:outline-none focus:border-carmine/60 focus:ring-1 focus:ring-carmine/30 resize-none transition" %>
        </div>
        <%= f.submit t("articles.show.post_comments"),
              class: "px-5 py-2 rounded-lg text-sm font-medium bg-carmine text-paper hover:bg-carmine/85 active:scale-95 transition cursor-pointer" %>
      <% end %>

      <% if article.comments.empty? %>
        <p class="text-paper/40 text-sm italic py-4 text-center border-t border-white/5">
          <%= t("articles.show.no_comments") %>
        </p>
      <% else %>
      <div class="border-t border-white/5 pt-4 space-y-3">
        <% article.comments.each do |comment| %>
          <div class="bg-black/20 border border-white/5 rounded-lg px-4 py-3">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-3">
                <% if comment.user %>
                  <%= link_to comment.user.username, user_path(comment.user),
                        class: "text-xs font-semibold text-carmine hover:underline" %>
                <% else %>
                  <span class="text-xs font-semibold text-carmine">Anonymous</span>
                <% end %>

                <% my_rating = logged_in? ? comment.ratings.find_by(rater: current_user ) : nil %>
                <div class="flex items-center gap-1">
                  <%= button_to article_comment_ratings_path(article, comment), params: { value: 1 }, method: :post,
                        class: "px-2 py-0.5 rounded text-xs transition #{my_rating&.value == 1 ? 'bg-carmine text-paper' : 'bg-white/5 text-paper/50 hover:bg-white/10'}" do %>
                    ▲
                  <% end %>
                  <span class="text-xs text-paper/50"><%= comment.score %></span>
                  <%= button_to article_comment_ratings_path(article, comment), params: { value: -1 }, method: :post,
                        class: "px-2 py-0.5 rounded text-xs transition #{my_rating&.value == -1 ? 'bg-carmine text-paper' : 'bg-white/5 text-paper/50 hover:bg-white/10'}" do %>
                    ▼
                  <% end %>
                </div>
              </div>

              <span class="text-xs text-paper/30">
                <%= comment.created_at.strftime("%b %-d, %Y · %H:%M") %>
                <% if comment.edited? %>
                  · edited
                <% end %>
              </span>
            </div>

            <div class="text-sm text-paper/75 leading-relaxed">
              <%= comment.content %>
            </div>

            <% if comment.editable_by?(current_user) %>
              <div class="flex gap-3 text-xs mt-2">
                <%= link_to "Edit", edit_article_comment_path(article, comment), class: "text-paper/40 hover:text-paper" %>
                <%= button_to "Delete", article_comment_path(article, comment), method: :delete,
                      class: "text-carmine/70 hover:text-carmine bg-transparent border-none p-0 cursor-pointer text-xs",
                      form_class: "inline", data: { turbo_confirm: "Delete this comment?" } %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
      </div>
    </div>
    <% if article.editable_by?(current_user) %>
      <div class="flex flex-wrap gap-2 mt-6 pt-4 border-t border-white/5">
        <%= link_to t("articles.show.edit_article"), edit_article_path(article),
              class: "px-5 py-2.5 rounded-lg text-sm font-medium bg-white/5 text-paper hover:bg-white/10 transition" %>
        <%= link_to t("articles.show.back_to_article"), articles_path,
              class: "px-5 py-2.5 rounded-lg text-sm font-medium text-paper/50 hover:text-paper hover:bg-white/5 transition" %>
        <%= button_to t("articles.show.delete_article"), article, method: :delete,
              form_class: "inline-block",
              class: "bg-carmine/15 text-carmine border border-carmine/30 px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-carmine hover:text-paper hover:border-carmine transition",
              data: { turbo_confirm: t("base.prompt.confirm") } %>
      </div>
    <% end %>

</div>