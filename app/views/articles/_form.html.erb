<%# Partial: articles/_form.html.erb
    Full form wrapper (form_with + fields + submit).
    Expects: `article` (Article object)
    submit_label (optional) — overrides the default submit button text
%>

<% submit_label ||= article.persisted? ? t("articles.create.update_article", default: "Update article") : t("articles.create.create_article") %>

<%= form_with(model: article, class: "space-y-6") do |form| %>
  <%= render "articles/fields", form: form, article: article %>

  <%# Actions %>
  <div class="flex items-center gap-3 pt-2 border-t border-white/5">
    <%= form.submit submit_label,
          class: "px-6 py-2.5 rounded-xl text-sm font-semibold bg-carmine text-paper hover:bg-carmine/85 active:scale-95 transition cursor-pointer" %>
    <%= link_to t("articles.create.cancel"), (article.persisted? ? article_path(article) : articles_path),
          class: "px-5 py-2.5 rounded-xl text-sm font-medium text-paper/50 hover:text-paper hover:bg-white/5 transition" %>
  </div>
<% end %>