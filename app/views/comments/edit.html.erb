<div class="w-4/5 mx-auto max-w-xl">
  <h1 class="font-display text-2xl text-paper mb-6">Edit comment</h1>

  <%= form_with model: [@comment.article, @comment], class: "space-y-4" do |f| %>
    <%= f.text_area :content, rows: 4,
          class: "w-full bg-white/5 border border-white/10 rounded-lg px-4 py-3 text-paper focus:outline-none focus:border-carmine transition" %>

    <div class="flex gap-3">
      <%= f.submit "Save changes", class: "bg-carmine text-paper px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-carmine/90 transition cursor-pointer" %>
      <%= link_to "Cancel", @comment.article, class: "px-5 py-2.5 rounded-lg text-sm font-medium bg-white/5 text-paper hover:bg-white/10 transition" %>
    </div>
  <% end %>
</div>